<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hides Instagram's Reels tab while it's on. Reels people send you still open."
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <!-- Main on/off switch -->
        <LinearLayout
            android:id="@+id/toggle_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Block Reels"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/toggle_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_dim"
                    android:textSize="14sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/block_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="1.3"
                android:scaleY="1.3" />
        </LinearLayout>

        <!-- Setup card: shown until the accessibility service is enabled -->
        <LinearLayout
            android:id="@+id/setup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One-time setup needed"
                android:textColor="@color/warn"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Remove Reels needs Accessibility access so it can see when Instagram is on screen.\n\n1. Tap the button below, find Remove Reels (it may be under &quot;Downloaded apps&quot; or &quot;Installed apps&quot;) and turn it on.\n\n2. If Android says it's a &quot;restricted setting&quot;, come back here and tap &quot;Allow restricted settings&quot;. On the App info screen, tap the ⋮ menu in the top-right corner, choose &quot;Allow restricted settings&quot;, then try step 1 again."
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/open_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/button"
                android:text="Open Accessibility settings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <Button
                android:id="@+id/open_app_info"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Allow restricted settings (App info)"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/service_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="✓ Accessibility access is on"
            android:textColor="@color/ok"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingMultiplier="1.2"
            android:text="Tip: swipe down twice from the top of the screen, tap the pencil icon, and drag the &quot;Block Reels&quot; tile into your Quick Settings to flip blocking on and off without opening this app."
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
